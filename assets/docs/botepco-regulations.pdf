<style>
	/* Base Header Setup */
.site-header {
  position: fixed !important;
  top: 0;
  left: 50% !important;
  transform: translateX(-50%) !important;
  width: 100% !important;
  max-width: 100% !important;
  padding: 20px 40px;
  background-color: rgba(255, 255, 255, 1);
  border-radius: 0px;
  border: 1px solid transparent;
  box-shadow: 0 0 0 rgba(0, 0, 0, 0);
  z-index: 9999;
  transition: 
    top 0.4s cubic-bezier(0.16, 1, 0.3, 1),
    width 0.4s cubic-bezier(0.16, 1, 0.3, 1),
    max-width 0.4s cubic-bezier(0.16, 1, 0.3, 1),
    padding 0.4s cubic-bezier(0.16, 1, 0.3, 1),
    background-color 0.4s ease,
    border-radius 0.4s cubic-bezier(0.16, 1, 0.3, 1),
    border-color 0.4s ease,
    box-shadow 0.4s ease;
}

/* Glassmorphic Pill (Triggered on Scroll) */
.site-header.is-scrolled {
  top: 5px !important;
  width: calc(100% - 32px) !important;
  max-width: 1140px !important; /* Adjust based on your site container width */
  padding: 10px 5px;
  background-color: rgba(255, 255, 255, 0.7) !important; /* Semi-transparent */
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: 50px !important;
  border: 1px solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
}

/* Dark Theme Variant (Optional) */
@media (prefers-color-scheme: dark) {
  .site-header.is-scrolled {
    background-color: rgba(255, 255, 255, 0.75) !important;
    border-color: rgba(47, 47, 47, 0.25);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3) !important;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const header = document.querySelector('.site-header');
  const scrollThreshold = 40; // Pixels scrolled before pill effect activates

  if (!header) return;

  const handleScroll = () => {
    if (window.scrollY > scrollThreshold) {
      header.classList.add('is-scrolled');
    } else {
      header.classList.remove('is-scrolled');
    }
  };

  // Run initial check and listen for scroll events
  handleScroll();
  window.addEventListener('scroll', handleScroll, { passive: true });
});
</script>
